# ── Outstatic CMS ──────────────────────────────────────────────
# GitHub OAuth App credentials (create at github.com/settings/developers)
OST_GITHUB_ID=your_github_oauth_app_client_id
OST_GITHUB_SECRET=your_github_oauth_app_client_secret

# A random secret string (use: openssl rand -base64 32)
OST_TOKEN_SECRET=your_random_secret_at_least_32_chars

# Your GitHub username
OST_GITHUB_MONOREPO_PATH=

# The GitHub repo where content is stored (format: owner/repo)
# Example: oceanuser/ocean-site
OST_REPO_SLUG=your_github_username/your-repo-name

# The branch to read/write content from
OST_REPO_BRANCH=main

# The base URL of your site (no trailing slash)
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
